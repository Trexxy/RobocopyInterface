<Window x:Class="RobocopyInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Sources label -->
            <RowDefinition Height="*" MinHeight="140"/>  <!-- Sources list -->
            <RowDefinition Height="Auto"/>   <!-- Add buttons -->
            <RowDefinition Height="2*" MinHeight="120"/> <!-- Log output -->
            <RowDefinition Height="Auto"/>   <!-- Progress + action button -->
        </Grid.RowDefinitions>

        <!-- Sources label -->
        <TextBlock Grid.Row="0"
                   Text="Sources"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4"/>

        <!-- Sources list -->
        <ListView Grid.Row="1"
                  x:Name="SourcesListView"
                  ItemsSource="{Binding Sources}"
                  IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                  Margin="0,0,0,4">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4,2"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Source}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1"
                                        Content="&#x2715;"
                                        Width="22" Height="22"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemoveSourceCommand, ElementName=SourcesListView}"
                                        CommandParameter="{Binding}"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#x2192;"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         Padding="4,2"/>
                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Command="{Binding DataContext.BrowseTargetCommand, ElementName=SourcesListView}"
                                        CommandParameter="{Binding}"
                                        Padding="10,2"
                                        Margin="6,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Add / Clear buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Clear"
                    Command="{Binding ClearSourcesCommand}"
                    IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                    Padding="10,4"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="+ Add Folder"
                        Command="{Binding AddFolderCommand}"
                        IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                        Padding="10,4"
                        Margin="0,0,6,0"/>
                <Button Content="+ Add File"
                        Command="{Binding AddFileCommand}"
                        IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                        Padding="10,4"/>
            </StackPanel>
        </Grid>

        <!-- Log output -->
        <Border Grid.Row="3"
                Margin="0,0,0,10"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Output"
                           FontWeight="SemiBold"
                           Margin="8,6,8,4"/>
                <ScrollViewer Grid.Row="1"
                              x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox"
                             Text="{Binding LogText, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Two progress bars + Start/Cancel button -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>   <!-- Labels -->
                <ColumnDefinition Width="*"/>    <!-- Bars -->
                <ColumnDefinition Width="Auto"/> <!-- Button spans both rows -->
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,8,4">
                <TextBlock Text="Overall"/>
                <TextBlock Text="{Binding OverallSizeText}"
                           FontSize="10"
                           Foreground="Gray"/>
            </StackPanel>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,10,4">
                <ProgressBar Value="{Binding OverallProgress}"
                             Minimum="0" Maximum="100"
                             Height="22"/>
                <TextBlock Text="{Binding OverallProgressText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- "Current file" label with copy speed stacked below -->
            <StackPanel Grid.Row="1" Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <TextBlock Text="Current file"/>
                <TextBlock Text="{Binding CopySpeed}"
                           FontSize="10"
                           Foreground="Gray"/>
            </StackPanel>

            <!-- Progress bar with percentage text overlaid in the centre -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                <ProgressBar Value="{Binding CurrentFileProgress}"
                             Minimum="0" Maximum="100"
                             Height="22"/>
                <TextBlock Text="{Binding CurrentFileProgress, Converter={StaticResource PercentTextConverter}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Start Sync / Cancel: two buttons, visibility-toggled on IsSyncing -->
            <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="2">
                <Button Content="Start Sync"
                        Command="{Binding StartSyncCommand}"
                        Padding="16,0" MinWidth="100" VerticalAlignment="Stretch"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                <Button Content="Cancel"
                        Command="{Binding CancelSyncCommand}"
                        Padding="16,0" MinWidth="100" VerticalAlignment="Stretch"
                        Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
