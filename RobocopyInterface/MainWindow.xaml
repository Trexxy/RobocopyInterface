<Window x:Class="RobocopyInterface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="RowIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Custom title bar -->
            <RowDefinition Height="3*" MinHeight="160"/>  <!-- Sources card -->
            <RowDefinition Height="5*" MinHeight="140"/>  <!-- Log card -->
            <RowDefinition Height="Auto"/>   <!-- Status / actions card -->
        </Grid.RowDefinitions>
        <Grid.RowSpacing>16</Grid.RowSpacing>

        <!-- ============ Custom title bar ============ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Robocopy Helper" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ============ Sources card ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="20,0,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                        <TextBlock Text="Sources" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                CornerRadius="10"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Sources.Count}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear"
                                Command="{Binding ClearSourcesCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                                Padding="12,6"/>
                        <Button Command="{Binding AddFolderCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add Folder"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddFileCommand}"
                                IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="Add File"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Empty state -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            Visibility="{Binding Sources.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource TextFillColorDisabledBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="No sources yet"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"/>
                    <TextBlock Text="Add a folder or file to start syncing"
                               HorizontalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"/>
                </StackPanel>

                <!-- Sources list -->
                <ListView Grid.Row="1"
                          x:Name="SourcesListView"
                          ItemsSource="{Binding Sources}"
                          SelectionMode="None"
                          IsEnabled="{Binding IsSyncing, Converter={StaticResource InverseBoolConverter}}"
                          Padding="0"
                          Visibility="{Binding Sources.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Invert}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <FontIcon Grid.Row="0" Grid.Column="0"
                                              Glyph="{Binding Source, Converter={StaticResource PathTypeToGlyphConverter}}"
                                              FontSize="15"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Source}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource RowIconButtonStyle}"
                                            Command="{Binding DataContext.RemoveSourceCommand, ElementName=SourcesListView}"
                                            CommandParameter="{Binding}">
                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                    </Button>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE72A;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Choose a target folder…"
                                             VerticalContentAlignment="Center"
                                             CornerRadius="6"
                                             Padding="8,6"/>
                                    <Button Grid.Row="1" Grid.Column="2"
                                            Content="Browse"
                                            Command="{Binding DataContext.BrowseTargetCommand, ElementName=SourcesListView}"
                                            CommandParameter="{Binding}"
                                            Padding="12,6"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ============ Log card ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="20,0,20,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="20,14,20,10">
                    <TextBlock Text="&gt;_" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Activity Log" Style="{StaticResource SectionHeaderStyle}"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#0C0C0C"
                        CornerRadius="0,0,12,12"
                        Padding="4">
                    <ScrollViewer x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="LogTextBox"
                                 Text="{Binding LogText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 Foreground="#D4D4D4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12,8"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Status / actions card ============ -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="20,0,20,20">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <!-- Overall progress -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Overall" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OverallSizeText}" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Value="{Binding OverallProgress}" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OverallProgressText}"
                                   VerticalAlignment="Center"
                                   MinWidth="90"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </Grid>

                    <!-- Current file progress -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Current file" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CopySpeed}" Style="{StaticResource MutedTextStyle}"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="1" Value="{Binding CurrentFileProgress}" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding CurrentFileProgress, Converter={StaticResource PercentTextConverter}}"
                                   VerticalAlignment="Center"
                                   MinWidth="90"
                                   Style="{StaticResource MutedTextStyle}"/>
                    </Grid>
                </StackPanel>

                <!-- Start Sync / Cancel -->
                <Grid Grid.Column="1">
                    <Button Command="{Binding StartSyncCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="18"
                            Padding="22,0" MinWidth="130" Height="42" VerticalAlignment="Center"
                            Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock Text="Start Sync" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelSyncCommand}"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            CornerRadius="18"
                            Padding="22,0" MinWidth="130" Height="42" VerticalAlignment="Center"
                            Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"/>
                            <TextBlock Text="Cancel" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
